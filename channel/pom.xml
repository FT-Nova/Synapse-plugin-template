<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- TODO: update groupId, artifactId, version, name, description, url -->
    <groupId>com.example</groupId>
    <artifactId>my-channel-plugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>My Channel Plugin</name>
    <description>TODO: short description</description>
    <url>https://github.com/your-author/your-channel-name</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>your-github-username</id><!-- TODO -->
            <name>Your Name</name><!-- TODO -->
        </developer>
    </developers>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>github-synapse</id>
            <url>https://maven.pkg.github.com/FTMahringer/Synapse</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- The only dependency plugins may import -->
        <dependency>
            <groupId>dev.synapse</groupId>
            <artifactId>synapse-plugin-api</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope><!-- provided by loader at runtime -->
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.14.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.14.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.26.3</version>
            <scope>test</scope>
        </dependency>
        <!-- Provide synapse-plugin-api on test classpath -->
        <dependency>
            <groupId>dev.synapse</groupId>
            <artifactId>synapse-plugin-api</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>
            <!-- Fat JAR without synapse-plugin-api (provided by loader) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <exclude>dev.synapse:synapse-plugin-api</exclude>
                                </excludes>
                            </artifactSet>
                            <archive>
                                <manifestEntries>
                                    <!-- TODO: update to match manifest.yml -->
                                    <Plugin-Id>your-author/your-channel-name</Plugin-Id>
                                    <Plugin-Version>${project.version}</Plugin-Version>
                                    <Plugin-Type>channel</Plugin-Type>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
